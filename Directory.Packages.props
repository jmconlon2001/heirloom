<Project>
  <!-- All package versions are pinned here. Adding a package not listed in BUILD_PROMPT §2
       requires an entry in docs/DECISIONS.md (reason + license). -->
  <ItemGroup>
    <!-- App -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageVersion Include="MailKit" Version="4.18.2" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Hangfire.Core" Version="1.8.25" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.25" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <PackageVersion Include="Magick.NET-Q8-AnyCPU" Version="15.1.1" />
    <PackageVersion Include="QRCoder" Version="1.9.0" />
    <PackageVersion Include="Scriban" Version="7.6.0" />
    <!-- Not used directly: pins Hangfire's transitive dependency past GHSA-5crp-9r3c-p9vr (see D-016). -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Tests -->
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.65.1" />
    <PackageVersion Include="Deque.AxeCore.Playwright" Version="4.14.0" />
  </ItemGroup>
</Project>
