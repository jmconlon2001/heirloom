# Family Memories configuration.
# Copy to .env next to compose.yml and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Basics
# ---------------------------------------------------------------------------
# Name shown in the header, page titles, and emails.
APP_NAME=Family Memories

# The address people type in their browser (your reverse-proxy sub-domain), no trailing slash.
# Every link in an email or QR code is built from this.
PUBLIC_BASE_URL=https://memories.example.com

# Host port the app listens on (plain HTTP; TLS is done by your reverse proxy).
APP_PORT=8095

# The first admin. Created on first start; sign in by asking for an email link.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Jacob

# Shown in the "Need help?" box on every page and at the bottom of emails.
HELP_NAME=Jacob
HELP_PHONE=(555) 010-0199

# Default timezone for the container (reminders get their own per-user setting in Phase 4).
TZ=America/New_York

# ---------------------------------------------------------------------------
# Storage (host paths)
# ---------------------------------------------------------------------------
# DATA_ROOT holds data/ (media, keys, logs, exports, config) and postgres/.
DATA_ROOT=/srv/dev-disk-by-uuid-XXXX/appdata/family-memories
# BACKUP_ROOT should be on a DIFFERENT physical disk from DATA_ROOT.
BACKUP_ROOT=/srv/dev-disk-by-uuid-YYYY/backups/family-memories

# User/group that owns files on the host (OpenMediaVault: id of your appuser; often 1000/100).
PUID=1000
PGID=100

# ---------------------------------------------------------------------------
# Database (shared by the app and the db container)
# ---------------------------------------------------------------------------
POSTGRES_DB=family_memories
POSTGRES_USER=family_memories
# Long random string, e.g. `openssl rand -base64 32`
POSTGRES_PASSWORD=change-me

# Take a pg_dump before applying database upgrades. Leave this on.
PRE_MIGRATION_BACKUP=true

# ---------------------------------------------------------------------------
# Backups (restic)
# ---------------------------------------------------------------------------
# The encryption password for every backup. WITHOUT IT THE BACKUPS CAN NEVER BE OPENED.
# Generate a long one (`openssl rand -base64 32`) and keep a copy in a password manager.
# Backups are switched off until this is set.
RESTIC_PASSWORD=
# The primary repository lives on BACKUP_ROOT (mounted at /backups). Leave as is.
RESTIC_REPOSITORY=/backups/restic
# Optional offsite copy: any restic backend (b2:, s3:, sftp:, rclone:). Put the backend's own
# credentials (e.g. B2_ACCOUNT_ID / B2_ACCOUNT_KEY, AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) below too.
OFFSITE_RESTIC_REPOSITORY=
# Defaults to RESTIC_PASSWORD.
OFFSITE_RESTIC_PASSWORD=
# Nightly backup time (24-hour, local to APP_TIMEZONE). The check runs Sundays two hours later.
BACKUP_TIME=02:30
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=12
# The family's time zone for schedules and emails.
APP_TIMEZONE=America/New_York

# Optional: admin alerts (failed backups and checks) also go to an ntfy topic.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# ---------------------------------------------------------------------------
# Optional extras (all off by default; see Family admin → Optional extras)
# ---------------------------------------------------------------------------
# Write down voice recordings with a local Whisper container (docker compose --profile transcription up -d).
FEATURE_TRANSCRIPTION=false
WHISPER_URL=http://whisper:9000
# Let storytellers answer by replying to the reminder email (photos too).
FEATURE_EMAIL_REPLIES=false
# A mailbox that supports plus-addressing; replies go to e.g. memories+AB12CD34@example.com.
REPLY_ADDRESS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SSL=true
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Printable paper packets of questions with writing lines.
FEATURE_PAPER_PACKETS=false

# ---------------------------------------------------------------------------
# Reverse proxy
# ---------------------------------------------------------------------------
# IPs or CIDR ranges allowed to set X-Forwarded-For / X-Forwarded-Proto.
# Put your OPNsense (Caddy) LAN address here, e.g. 192.168.1.1
# For the local dev proxy (compose profile "proxy"), use the frontend subnet: 172.30.95.0/24
TRUSTED_PROXIES=192.168.1.1
# Subnet for the stack's frontend network (change only if it clashes with your LAN).
FRONTEND_SUBNET=172.30.95.0/24

# ---------------------------------------------------------------------------
# Stories and uploads
# ---------------------------------------------------------------------------
# Who can see a new story by default: AllFamily (recommended) or Private.
DEFAULT_VISIBILITY=AllFamily
# Upload limits in MB. Images and PDFs share the image limit.
MAX_IMAGE_MB=25
MAX_AUDIO_MB=200
MAX_VIDEO_MB=1024
# How many days a printed QR login card keeps working (it works once).
LOGIN_CARD_DAYS=30

# Sign-in form posts allowed per IP per 10 minutes.
AUTH_RATE_LIMIT=10

# ---------------------------------------------------------------------------
# Email (SMTP)
# ---------------------------------------------------------------------------
# These are the starting values. An admin can change them later under Family admin → Email
# (the password is then stored encrypted in the database and takes over from these).
# Gmail / Google Workspace: host smtp.gmail.com, port 587, StartTls, username = your address,
#   password = an App Password (https://myaccount.google.com/apppasswords).
# Development with Mailpit (compose --profile dev): host mailpit, port 1025, security None, no username.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# None | StartTls | SslOnConnect
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=memories@example.com
SMTP_FROM_NAME=Family Memories

# ---------------------------------------------------------------------------
# Status and monitoring
# ---------------------------------------------------------------------------
# /healthz  is the app running (always 200 while it is)
# /readyz   database and PDF maker reachable
# /status   a plain-language page: anyone sees each part's state, admins also see the details
# /api/status  JSON; anyone gets {"status": "ok" | "warning" | "problem"}; 503 when something is broken.
# With this token, a monitor (Uptime Kuma, Healthchecks, Home Assistant…) gets every component's details by sending
#   Authorization: Bearer <STATUS_TOKEN>
# Generate one with: openssl rand -hex 24
STATUS_TOKEN=

# The landing page's "See Family Memories on GitHub" link. Leave empty (PROJECT_URL=) to hide it.
# PROJECT_URL=https://github.com/jmconlon2001/heirloom

# ---------------------------------------------------------------------------
# Demo mode (beta testing only)
# ---------------------------------------------------------------------------
# true = on an empty site, create a made-up family (Grandma Rose, Ann, Lily, a family tree,
# stories with photos) and show one-tap "Try the demo" sign-in buttons for the admin, Rose and Lily.
# WARNING: anyone who can reach the site can then sign in as the admin. Never turn this on for a
# site with real family stories, and put a beta site behind basic auth or an IP allow-list.
DEMO_MODE=false
