root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,yml,yaml,csproj,props,cshtml,html,css,js}]
indent_size = 2

[*.cs]
dotnet_style_qualification_for_field = false
csharp_style_namespace_declarations = file_scoped:warning
