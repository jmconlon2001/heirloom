@model SitePage
@{
    Layout = "/Templates/Export/Site/_Layout.cshtml";
    var s = Model.Story!;
}
<article class="story">
    @if (s.Question is not null) { <p class="eyebrow">@s.Question</p> }
    <h1>@s.Memory.Title</h1>
    <p class="byline">Told by @s.Teller@(s.WrittenBy is not null ? $" · written down by {s.WrittenBy}" : "")</p>
    @if (s.When.Length > 0 || s.Memory.Place is not null) { <p class="muted">@string.Join(" · ", new[] { s.When, s.Memory.Place }.Where(x => !string.IsNullOrEmpty(x)))</p> }
    @if (s.People.Count > 0)
    {
        <p class="muted">In this story:
            @foreach (var p in s.People)
            {
                var person = Model.Content.People.First(x => x.Person.Id == p.Id);
                <a href="@SitePage.PersonHref(person)">@p.DisplayName</a>
            }
        </p>
    }
    <div class="story-body">
        @foreach (var b in s.Blocks)
        {
            switch (b.Kind)
            {
                case FamilyMemories.Stories.StoryBlockKind.Heading: <h2 class="story-heading">@Html.Raw(b.Html)</h2> break;
                case FamilyMemories.Stories.StoryBlockKind.BulletList: <ul>@foreach (var item in b.Items) { <li>@Html.Raw(item)</li> }</ul> break;
                case FamilyMemories.Stories.StoryBlockKind.NumberedList: <ol>@foreach (var item in b.Items) { <li>@Html.Raw(item)</li> }</ol> break;
                case FamilyMemories.Stories.StoryBlockKind.Quote: <blockquote><p>@Html.Raw(b.Html)</p></blockquote> break;
                case FamilyMemories.Stories.StoryBlockKind.Media:
                    if (s.PhotoAt(b.MediaId) is { } placedPhoto) { Photo(placedPhoto, b.Caption); }
                    else if (s.ClipAt(b.MediaId) is { } placedClip) { Clip(placedClip, b.Caption); }
                    break;
                default: <p>@Html.Raw(b.Html)</p> break;
            }
        }
    </div>
    @foreach (var photo in s.UnplacedPhotos) { Photo(photo, null); }
    @foreach (var clip in s.UnplacedClips) { Clip(clip, null); }
    @foreach (var doc in s.Documents)
    {
        <p><a href="@SitePage.Media(doc, "original" + doc.Extension)">Open @doc.OriginalFileName</a></p>
    }
</article>

@functions {
    // Story text blocks come from StoryMarkup, which HTML-encodes everything itself.
    private void Photo(ExportPhoto photo, string? placedCaption)
    {
        var caption = placedCaption ?? photo.Caption;
        <figure class="photo">
            <a href="@SitePage.Media(photo.Attachment, "web.jpg")"><img src="@SitePage.Media(photo.Attachment, "web.jpg")" alt="@(caption ?? "Photo")" loading="lazy"></a>
            @if (caption is not null || photo.People.Count > 0)
            {
                <figcaption>@caption@(photo.People.Count > 0 ? $"{(caption is null ? "" : " · ")}{string.Join(", ", photo.People)}" : "")</figcaption>
            }
        </figure>
    }

    private void Clip(ExportClip clip, string? placedCaption)
    {
        var caption = placedCaption ?? clip.Caption;
        <figure class="clip">
            @if (clip.Attachment.Kind == AttachmentKind.Video)
            {
                <video controls preload="none" poster="@SitePage.Media(clip.Attachment, "poster.jpg")" src="@SitePage.Media(clip.Attachment, Model.VideoName(clip.Attachment))" playsinline></video>
            }
            else
            {
                <audio controls preload="none" src="@SitePage.Media(clip.Attachment, "audio.m4a")"></audio>
            }
            @if (caption is not null) { <figcaption>@caption</figcaption> }
        </figure>
    }
}
