@model CoverView
@{ var o = Model.Options; }
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Cover: @o.Title</title>
    <style>@Html.Raw(Model.StyleSheet)</style>
    <style>@Html.Raw(Model.Css())</style>
</head>
<body>
    <div class="spread">
        <section class="back">
            @if (Model.BackPhoto is not null) { <img src="@Model.BackPhoto" alt=""> }
            @if (!string.IsNullOrWhiteSpace(o.BackText)) { <p class="back-text">@o.BackText</p> }
        </section>
        <section class="spine">
            @if (Model.SpineText) { <p class="spine-title">@o.Title</p> }
        </section>
        <section class="front">
            <h1>@o.Title</h1>
            @if (!string.IsNullOrWhiteSpace(o.Subtitle)) { <p class="subtitle">@o.Subtitle</p> }
            @if (Model.FrontPhoto is not null) { <img src="@Model.FrontPhoto" alt=""> }
            <svg class="mark" viewBox="0 0 64 80" aria-hidden="true"><g fill="none" stroke="currentColor"><circle cx="32" cy="7" r="4.5" stroke-width="3"/><path d="M32 11.5V16" stroke-width="3"/><path d="M32 16C14 16 6 30 6 44c0 18 12 32 26 32s26-14 26-32c0-14-8-28-26-28Z" stroke-width="4"/><path d="M32 64V44" stroke-width="3.2" stroke-linecap="round"/></g><g fill="currentColor"><path d="M32 47c0-9-8-14-15-13 0 8 7 13 15 13Z"/><path d="M32 52c0-8 7-13 14-12 0 8-7 12-14 12Z"/></g></svg>
        </section>
    </div>
</body>
</html>
