@model FamilyMemories.Family.Kin
@if (Model.Parents.Count + Model.Partners.Count + Model.Children.Count + Model.Siblings.Count == 0)
{
    <p class="muted">No family connections added yet.</p>
    return;
}
<dl class="kin">
    @if (Model.Parents.Count > 0)
    {
        <dt>Parents</dt>
        <dd>@foreach (var x in Model.Parents) { <a href="/people/@x.Id">@x.DisplayName</a><br> }</dd>
    }
    @if (Model.Partners.Count > 0)
    {
        <dt>@(Model.Partners.Any(x => x.Link.Kind == FamilyMemories.Data.PartnershipKind.Married) ? "Married to" : "Partner")</dt>
        <dd>@foreach (var (x, link) in Model.Partners)
            {
                <a href="/people/@x.Id">@x.DisplayName</a>
                <span class="muted">@(link.Kind == FamilyMemories.Data.PartnershipKind.Divorced ? "(divorced)" : "")@(link.StartYear is { } y ? $" since {y}" : "")</span><br>
            }</dd>
    }
    @if (Model.Children.Count > 0)
    {
        <dt>Children</dt>
        <dd>@foreach (var x in Model.Children) { <a href="/people/@x.Id">@x.DisplayName</a><br> }</dd>
    }
    @if (Model.Siblings.Count > 0)
    {
        <dt>Brothers and sisters</dt>
        <dd>@foreach (var x in Model.Siblings) { <a href="/people/@x.Id">@x.DisplayName</a><br> }</dd>
    }
</dl>
