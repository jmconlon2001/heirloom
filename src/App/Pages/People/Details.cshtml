@page "/people/{id:guid}"
@model FamilyMemories.Pages.People.DetailsModel
@{
    var p = Model.Kin.Person;
    ViewData["Title"] = p.DisplayName;
    var span = FamilyMemories.Family.PeopleService.LifeSpan(p, User.IsAdmin());
}
<partial name="_Flash" />
<div class="person-header">
    @if (p.PhotoAttachmentId is { } photo)
    {
        <img src="/media/@photo/web" alt="Photo of @p.DisplayName" class="person-photo">
    }
    <div>
        <h1>@p.DisplayName</h1>
        @if (p.Nickname is not null) { <p class="lead">Known as “@p.Nickname”</p> }
        @if (p.BirthSurname is not null && p.BirthSurname != p.Surname) { <p>Born @p.GivenNames @p.BirthSurname</p> }
        @if (span.Length > 0) { <p class="life-span">@span</p> }
        @if (p.BirthPlace is not null) { <p>Born in @p.BirthPlace</p> }
        @if (p.DeathPlace is not null) { <p>Died in @p.DeathPlace</p> }
    </div>
</div>
@if (p.Bio is not null)
{
    <p class="person-bio">@p.Bio</p>
}
@if (Model.Links.Count > 0)
{
    <ul class="person-links" aria-label="Links about @p.DisplayName">
        @foreach (var l in Model.Links) { <li><a href="@l.Url" rel="noopener">@l.Label</a></li> }
    </ul>
}

<div class="button-row">
    <form method="post" asp-page="/Stories/New">
        <input type="hidden" name="about" value="@p.Id">
        <button type="submit" class="button button-primary">Write a story about @p.GivenNames.Split(' ')[0]</button>
    </form>
    <a class="button button-secondary" href="/tree?focus=@p.Id">See in the family tree</a>
    <a class="button button-quiet" href="/people/@p.Id/edit">Edit</a>
</div>

@if (Model.Facts.Count > 0)
{
    var events = Model.Facts.Where(f => f.Kind is not ("NOTE" or "SOUR")).ToList();
    var notes = Model.Facts.Where(f => f.Kind == "NOTE").ToList();
    var general = Model.Facts.Where(f => f.Kind == "SOUR").SelectMany(f => f.Citations).ToList();
    var sourceCount = Model.Facts.SelectMany(f => f.Citations).Select(c => c.Title).Distinct().Count();
    <details class="life-events" open="@(Model.Detailed)">
        <summary>Life events@(sourceCount > 0 ? $" and sources ({sourceCount})" : "")</summary>
        @if (events.Count > 0)
        {
            <ol class="event-list">
                @foreach (var f in events)
                {
                    <li>
                        @* §7: a living person's birth date shows only its year to non-admins, here as everywhere else. *@
                        <span class="event-date">@(p.IsLiving && !User.IsAdmin() && f.Kind is "BIRT" or "CHR" or "BAPM" ? f.Date.Year?.ToString() ?? "" : f.Date.Format())</span>
                        <span class="event-what"><strong>@f.Label</strong>@(f.Value is null ? "" : $": {f.Value}")@(f.Place is null ? "" : $", {f.Place}")</span>
                        @if (f.Note is not null) { <span class="event-note">@f.Note</span> }
                        @if (f.Citations.Count > 0)
                        {
                            <details class="sources">
                                <summary>Sources (@f.Citations.Count)<span class="visually-hidden"> for @f.Label</span></summary>
                                <partial name="_Citations" model="f.Citations" />
                            </details>
                        }
                    </li>
                }
            </ol>
        }
        @foreach (var n in notes) { <p class="person-note">@n.Note</p> }
        @if (general.Count > 0)
        {
            <h3>Sources about @p.GivenNames.Split(' ')[0]</h3>
            <partial name="_Citations" model="general" />
        }
        @if (Model.Facts.Any(f => f.FromGedcom))
        {
            var treeUrl = AppOptions.MainTreeUrl;
            <p class="muted">From the family's main tree. To change these, change them there and import it again.@if (treeUrl is not null) {<text> <a href="@treeUrl" rel="noopener">Open the main tree</a></text>}</p>
        }
    </details>
}

<section aria-labelledby="family-heading">
    <h2 id="family-heading">Close family</h2>
    <partial name="_KinList" model="Model.Kin" />
</section>

@if (Model.ToldBy.Count > 0)
{
    <section aria-labelledby="told-heading">
        <h2 id="told-heading">Stories told by @p.GivenNames.Split(' ')[0]</h2>
        <ul class="story-cards">
            @foreach (var c in Model.ToldBy) { <partial name="../Library/_StoryCard" model="c" /> }
        </ul>
    </section>
}
<section aria-labelledby="about-heading">
    <h2 id="about-heading">Stories about @p.GivenNames.Split(' ')[0]</h2>
    @if (Model.About.Count == 0)
    {
        <p class="muted">None yet. Do you remember something about @p.GivenNames.Split(' ')[0]? Write it down with the button above.</p>
    }
    <ul class="story-cards">
        @foreach (var c in Model.About) { <partial name="../Library/_StoryCard" model="c" /> }
    </ul>
</section>
@if (Model.Photos.Count > 0)
{
    <section aria-labelledby="photos-heading">
        <h2 id="photos-heading">Photos @p.GivenNames.Split(' ')[0] appears in</h2>
        <ul class="photo-grid">
            @foreach (var a in Model.Photos)
            {
                <li><a href="/library/photos/@a.Id"><img src="/media/@a.Id/thumb" alt="@(a.Caption ?? $"Photo with {p.DisplayName}")" loading="lazy" width="400" height="400"></a></li>
            }
        </ul>
    </section>
}
