@model (FamilyMemories.Data.Attachment Item, bool IsFirst, bool IsLast, List<FamilyMemories.Data.Person> Tagged)
@{
    var a = Model.Item;
}
<li class="attachment" id="attachment-@a.Id" data-attachment-id="@a.Id" data-state="@a.State.ToString().ToLowerInvariant()" data-transcript="@a.TranscriptState.ToString().ToLowerInvariant()">
    <partial name="_AttachmentPreview" model="a" />
    @if (a.TranscriptState == FamilyMemories.Data.TranscriptState.Pending)
    {
        <p class="transcript-wait">Writing down what you said… this can take a minute.</p>
    }
    else if (a.TranscriptState == FamilyMemories.Data.TranscriptState.Ready)
    {
        <div class="transcript">
            <label for="transcript-@a.Id">Here's what we heard. Fix anything that's wrong:</label>
            <textarea id="transcript-@a.Id" name="Transcripts[@a.Id]" rows="5" spellcheck="true">@a.Transcript</textarea>
            <div class="button-row">
                <button type="submit" class="button button-primary" asp-page-handler="UseTranscript" name="attachmentId" value="@a.Id">Add these words to my story</button>
                <button type="submit" class="button button-quiet" asp-page-handler="DismissTranscript" name="attachmentId" value="@a.Id">No thanks</button>
            </div>
        </div>
    }
    <div class="attachment-details">
        <div class="field">
            <label for="caption-@a.Id">Caption</label>
            <input type="text" id="caption-@a.Id" name="Captions[@a.Id]" value="@a.Caption" maxlength="1000"
                   placeholder="Who is in it? Where? When?" autocomplete="off" data-caption>
        </div>
        @if (a.Kind == FamilyMemories.Data.AttachmentKind.Photo)
        {
            <fieldset class="photo-people">
                <legend>Who's in this photo?</legend>
                <input type="hidden" name="PhotoFormPresent" value="@a.Id">
                @foreach (var p in Model.Tagged)
                {
                    <div class="checkbox">
                        <input type="checkbox" id="pp-@a.Id-@p.Id" name="PhotoPeople[@a.Id]" value="@p.Id" checked data-structural>
                        <label for="pp-@a.Id-@p.Id">@p.DisplayName</label>
                    </div>
                }
                <div class="field-row">
                    <div class="field">
                        <label for="pa-@a.Id">Add a person</label>
                        <input id="pa-@a.Id" name="PhotoAddPerson[@a.Id]" type="text" list="people-names" autocomplete="off" placeholder="Start typing a name">
                    </div>
                    <button type="submit" class="button button-secondary" asp-page-handler="Save" asp-fragment="attachment-@a.Id">Add</button>
                </div>
            </fieldset>
        }
        <div class="button-row attachment-buttons">
            @if (!Model.IsFirst)
            {
                <button type="submit" class="button button-quiet" asp-page-handler="Move" asp-route-direction="-1" name="attachmentId" value="@a.Id">Move up</button>
            }
            @if (!Model.IsLast)
            {
                <button type="submit" class="button button-quiet" asp-page-handler="Move" asp-route-direction="1" name="attachmentId" value="@a.Id">Move down</button>
            }
            <button type="submit" class="button button-quiet" asp-page-handler="Remove" name="attachmentId" value="@a.Id">Remove</button>
        </div>
    </div>
</li>
