@model FamilyMemories.Admin.AdminViewMode
@using FamilyMemories.Admin
<form class="admin-view-toggle" method="post" action="/admin/view">
    @Html.AntiForgeryToken()
    <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)">
    <span class="control-label" id="admin-view-label">Admin view</span>
    <div class="segmented" role="group" aria-labelledby="admin-view-label">
        <button type="submit" name="mode" value="basic" class="button button-toggle" aria-pressed="@(Model == AdminViewMode.Basic ? "true" : "false")">Basic</button>
        <button type="submit" name="mode" value="complex" class="button button-toggle" aria-pressed="@(Model == AdminViewMode.Complex ? "true" : "false")">Complex</button>
    </div>
</form>
