@page "/admin"
@{
    ViewData["Title"] = "Family admin";
}
<h1>Family admin</h1>
@inject FamilyMemories.Backup.BackupStatusQuery BackupStatus
<partial name="_BackupHealth" model="await BackupStatus.GetAsync()" />
<ul class="link-list link-list-large">
    <li><a href="/admin/users">People and invitations</a></li>
    <li><a href="/admin/prompts">Questions and chapters</a></li>
    <li><a href="/admin/prompt-sets">Question sets</a></li>
    <li><a href="/admin/backups">Backups</a></li>
    <li><a href="/admin/gedcom">Import or export the family tree (GEDCOM)</a></li>
    <li><a href="/admin/audit">Activity log</a></li>
    @if (AppOptions.JobsEnabled)
    {
        <li><a href="/admin/jobs">Background jobs</a></li>
    }
</ul>
