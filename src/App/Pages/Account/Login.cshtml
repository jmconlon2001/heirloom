@page "/account/login"
@model FamilyMemories.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<h1>Sign in</h1>
<p class="lead">Type your email address. We'll email you a link. Tap it, and you're in. There's no password to remember.</p>

<form method="post" class="stack" novalidate>
    <input type="hidden" asp-for="ReturnUrl">
    <div class="field">
        <label asp-for="Email">Your email address</label>
        @if (Model.ErrorMessage is not null)
        {
            <p class="field-error" id="email-error">@Model.ErrorMessage</p>
        }
        <input asp-for="Email" type="email" autocomplete="email" inputmode="email" autocapitalize="none"
               spellcheck="false" required aria-describedby="@(Model.ErrorMessage is null ? null : "email-error")"
               aria-invalid="@(Model.ErrorMessage is null ? "false" : "true")">
    </div>
    <button type="submit" class="button button-primary button-large">Email me a sign-in link</button>
</form>

@if (AppOptions.DemoMode)
{
    <section class="card demo-signin" aria-labelledby="demo-heading">
        <h2 id="demo-heading">Try the demo</h2>
        <p>This is a demonstration site with a made-up family. Sign in with one tap as:</p>
        <div class="stack">
            <form method="post" asp-page-handler="Demo"><input type="hidden" name="who" value="admin"><button type="submit" class="button button-secondary button-large">The family admin</button></form>
            <form method="post" asp-page-handler="Demo"><input type="hidden" name="who" value="rose"><button type="submit" class="button button-secondary button-large">Grandma Rose (storyteller, age 95)</button></form>
            <form method="post" asp-page-handler="Demo"><input type="hidden" name="who" value="lily"><button type="submit" class="button button-secondary button-large">Lily (granddaughter, reads the stories)</button></form>
        </div>
    </section>
}
